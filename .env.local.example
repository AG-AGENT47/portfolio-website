# Copy to .env.local and fill in your values
# Also add these to Vercel dashboard → Settings → Environment Variables

# Neon PostgreSQL connection string (server-side only — never expose to browser)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Go RAG chatbot API (client-side — chat SSE + health pre-warm)
NEXT_PUBLIC_API_URL=https://rag-chatbot-qge9.onrender.com
